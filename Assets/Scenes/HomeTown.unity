    m_Bits: 0
--- !u!114 &880000010
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 957034041}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b8d5f02a3c9e5f7b0a2d4e6f8b9c0d1e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  speakerName: Black Smith Cat
  dialoguePages:
  - "Kit! Bring me more scrap from Malice's raids\u2014best steel in the valley."
  - She builds 'em tough. I melt 'em tougher.
  - While raking coals I found paper stuck under the bellows. Small shots are fine,
    but charged medium and big shots break tough bots faster. Don't forget to hold
    attack.
  dialoguePagesMalice:
  - Malice. No custom blades for army bosses.
  - Leave.
  - Paper fluttered into the quench bucket. I won't gift you the grapple-into-slash
    advice on it. You'll figure pain without my help.
  dialoguePagesCount:
  - "Count\u2014your Hyper Speed makes my hammer feel polite. Whole forge appreciates
    quieter raids."
  - Keep stretching those seconds when Malice pushes. Metal cools; townsfolk don't.
  - "Found paper wedged in the tongs. Flip Hyper Speed on before an elite bot\u2014then
    empty clock shots into the weak point. You can dash while it's running."
  dialoguePagesHarlie:
  - Harlie! Edge is true. Malice's army learns respect the hard way.
  - Your sword's the judge.
  - "Paper was stuck to a cooling horseshoe. Charge-kick once you're over half charge\u2014clears
    a lane when bots crowd the anvil street."
  interactRadius: {fileID: 0}
  interactCollider: {fileID: 0}
  interactableSymbolBox: {fileID: 0}
  interactSymbolPrefab: {fileID: 4100001001001001004, guid: e1a8c35d6f2b8c0e3d5a7b9c1e2f3a4b, type: 3}
  interactSymbolInstance: {fileID: 0}
  stickUpThreshold: 0.5
  shopAfterDialogue: {fileID: 0}
