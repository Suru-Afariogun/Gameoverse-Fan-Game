    m_Bits: 0
--- !u!114 &880000012
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2076935357}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b8d5f02a3c9e5f7b0a2d4e6f8b9c0d1e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  speakerName: Granny Cat
  dialoguePages:
  - "Kit, dear\u2014tea first, then Malice. Even heroes need warm paws."
  - Your smile shouldn't wait on robots.
  - "While kneading dough a paper slid out from under the bowl. Hold attack to charge
    bigger shots\u2026 and dash-jump keeps you fast until you land. Doughy, but wise."
  dialoguePagesMalice:
  - Malice. Sit if you must. I still think you're a rotten army boss.
  - Kit sets out an extra cup. I didn't.
  - "A scrap of paper was in my knitting basket. Grapple and slash belong elsewhere\u2014not
    on my porch."
  dialoguePagesCount:
  - "Count, sit. Hyper Speed wears a body out\u2014especially Up-Hyper, when you
    crawl with the world."
  - When you slow the street, my shutters stop rattling. That's a kindness.
  - "Found paper bookmarking my recipe cards. Toggle Hyper Speed when you're overwhelmed,
    cancel early to keep the pool, and don't empty all sixteen seconds unless you
    must\u2014that cooldown leaves you weaker. No need to rush a gift like yours."
  dialoguePagesHarlie:
  - "Harlie, child\u2014sheathe that sword before cookies. Then go humble Malice's
    army."
  - You're the blade between them and my garden.
  - Paper was stuck to a cookie sheet. Pogo on their crowns, then finish the sword
    combo on the way down. Clean, polite violence.
  interactRadius: {fileID: 0}
  interactCollider: {fileID: 0}
  interactableSymbolBox: {fileID: 0}
  interactSymbolPrefab: {fileID: 4100001001001001004, guid: e1a8c35d6f2b8c0e3d5a7b9c1e2f3a4b, type: 3}
  interactSymbolInstance: {fileID: 0}
